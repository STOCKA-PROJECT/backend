# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=stockadb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password

# Security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_random_hex_string
JWT_EXPIRATION_TIME=86400000

# Bootstrap admin — si alguna está vacía, el seeder no crea cuenta y registra un WARN.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email
# Options for EMAIL_PROVIDER:
#   - resend
#   - smtp  → uses SMTP_* config below. In dev, MailHog (docker compose up) at localhost:1025, UI at http://localhost:8025.
#   - local → renders templates and dumps HTML files to target/emails/ (no SMTP needed, useful in CI).
EMAIL_PROVIDER=resend
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
FRONTEND_BASE_URL=http://localhost:3002

# Google sign-in (dev/staging only; refused on startup under a prod profile)
GOOGLE_OAUTH_ENABLED=false

# Swagger UI (dev only). Leave false in production.
# When enabled: UI at http://localhost:9095/swagger-ui.html
SWAGGER_ENABLED=true

# Sentry (error monitoring). Leave SENTRY_DSN empty to disable.
# Get the DSN from https://sentry.io > Project Settings > Client Keys (DSN).
SENTRY_DSN=https://5dd0cb4b1cae841048bc70cc78c7cf94@o4511302617464832.ingest.de.sentry.io/4511302629064784
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=local

# CORS — allowlist explícita (separada por comas). No se admiten comodines.
# Añade cada origen del frontend que necesite llamar al API desde el navegador.
CORS_ALLOWED_ORIGINS=http://localhost:3002,https://stocka.joanmartorellcoll03.workers.dev

# Cloudflare R2 (S3-compatible storage para imágenes y documentos de piezas)
R2_USE_LOCAL=false
R2_BUCKET=stocka
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_PRESIGNED_TTL=5

# Semantic piece search through XEYE (https://xeye.es). Leave disabled locally.
# The key needs the scopes lists:write, trainings:write and search (create it in the XEYE console).
XEYE_SEARCH_ENABLED=false
XEYE_API_KEY=
# Optional tuning: XEYE_MIN_SCORE=0.3 XEYE_MAX_RESULTS=200 XEYE_TRAINING_DELAY=10m XEYE_LLM_ENRICHMENT=true

# OAuth 2.1 authorization server + MCP server (/mcp) for assistants such as Claude.
# Locally nothing is required: without OAUTH_JWK_PRIVATE_KEY an ephemeral RSA key is generated and the
# issuer defaults to http://localhost:9095. In production OAUTH_ISSUER must be the public backend URL and
# the key is mandatory: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | tr '\n' '|' (store with
# literal \n or the | replaced back by newlines; the loader accepts literal \n sequences).
OAUTH_ISSUER=http://localhost:9095
OAUTH_JWK_PRIVATE_KEY=
OAUTH_JWK_KID=stocka-1
# Browser login/consent session cookie: set to false for plain-http local runs.
OAUTH_SESSION_COOKIE_SECURE=false
# Dynamic client registration (RFC 7591) for clients without a Client ID Metadata Document.
OAUTH_DCR_ENABLED=true
OAUTH_CIMD_TRUSTED_HOSTS=claude.ai
MCP_ENABLED=true
# MCP_RESOURCE_URL defaults to ${OAUTH_ISSUER}/mcp
MCP_RESOURCE_URL=
