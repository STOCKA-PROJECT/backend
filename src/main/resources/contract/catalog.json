{
  "format": "stocka-catalog",
  "version": 3,
  "types": ["int", "number", "bool", "string", "rgb", "rgb_list", "enum"],
  "kinds": {
    "relay": {
      "controller": "RelayController",
      "infrastructure": false,
      "pin": "optional",
      "notes": "Sortida tot/res. O bé un GPIO natiu (pin) o bé un canal d'un expansor (expander + channel), mai els dos. activeLow només per a relés natius; en un expansor la polaritat és de tota la placa.",
      "legacy": { "addressing": "name", "pinType": "Relé", "module": "output" },
      "config": {
        "expander": { "type": "string", "ref": "gpio_expander", "notes": "Nom d'un port gpio_expander; amb expander cal channel i no hi pot haver pin." },
        "channel": { "type": "int", "min": 0, "max": 15 },
        "activeLow": { "type": "bool", "default": false, "notes": "Placa de relés activa a nivell baix: nivell alt = apagat." }
      },
      "actions": {
        "turn_on": {
          "params": { "time": { "type": "number", "min": 0, "duration": true } }
        },
        "turn_off": {
          "params": { "time": { "type": "number", "min": 0, "duration": true } }
        },
        "double_pulse": {
          "notes": "Doble pulsació seguida d'un botó: tanca first_press s, obre gap s, tanca second_press s i deixa el relé obert. Cap paràmetre és la durada del clip: es pensen per fixar-los com a valors estàtics a l'acció del tipus de peça.",
          "params": {
            "first_press": { "type": "number", "min": 0, "required": true, "static": true, "notes": "Segons de la primera pulsació (relé tancat)." },
            "gap": { "type": "number", "min": 0, "required": true, "static": true, "notes": "Segons entre les dues pulsacions (relé obert)." },
            "second_press": { "type": "number", "min": 0, "required": true, "static": true, "notes": "Segons de la segona pulsació (relé tancat); després queda obert." }
          }
        }
      }
    },
    "gpio_expander": {
      "controller": "RelayController",
      "infrastructure": true,
      "pin": false,
      "notes": "Expansor MCP23017 per I2C amb 16 canals per a relés; infraestructura sense tipus de peça ni accions. Amb un expansor al show, els GPIO 2 i 3 (I2C) queden reservats.",
      "legacy": { "addressing": "name" },
      "config": {
        "chip": { "type": "enum", "required": true, "values": ["mcp23017"] },
        "bus": { "type": "int", "min": 0, "max": 1, "default": 1 },
        "address": { "type": "int", "required": true, "min": 32, "max": 39, "notes": "Adreça I2C 0x20–0x27 (32–39), única per bus." },
        "activeLow": { "type": "bool", "default": false }
      },
      "actions": {}
    },
    "led_strip": {
      "controller": "LedsController",
      "infrastructure": true,
      "pin": true,
      "notes": "Una tira física és alhora un objectiu de show: fill, animate i clear hi actuen sobre tota la tira (first/last relatius a la tira). infrastructure=true només vol dir que pot existir sense tipus de peça.",
      "legacy": { "addressing": "name", "pinType": "Tira LED", "module": "output" },
      "config": {
        "dma": { "type": "int", "required": true, "min": 0, "max": 14 },
        "channel": { "type": "int", "required": true, "min": 0, "max": 1 },
        "length": { "type": "int", "required": true, "min": 1 },
        "brightness": { "type": "int", "min": 0, "max": 255, "default": 255 },
        "freq_hz": { "type": "int", "min": 1, "default": 800000 },
        "invert": { "type": "bool", "default": false }
      },
      "actions": {
        "fill": {
          "params": {
            "color": { "type": "rgb", "required": true },
            "first": { "type": "int", "min": 0 },
            "last": { "type": "int", "min": 0 }
          }
        },
        "clear": { "params": {} },
        "animate": {
          "continuous": true,
          "params": {
            "animation_type": {
              "type": "enum",
              "required": true,
              "values": ["stars", "fire", "window_light", "candle", "moonlight", "clouds", "shooting_star", "aurora", "snow", "fade", "sunrise", "sunset"]
            },
            "first": { "type": "int", "min": 0 },
            "last": { "type": "int", "min": 0 },
            "duration": { "type": "number", "min": 0, "duration": true }
          },
          "animations": {
            "fade": {
              "params": {
                "color": { "type": "rgb", "required": true },
                "from_color": { "type": "rgb" },
                "waypoints": { "type": "rgb_list", "notes": "Colors intermedis entre from_color i color; la durada es reparteix a parts iguals entre trams." }
              },
              "transition": true,
              "notes": "duration per defecte 1.0 s. Sense from_color comença des del color del fade anterior o des de negre."
            },
            "stars": {
              "params": {
                "density": { "type": "number", "min": 0, "max": 1, "default": 0.1 },
                "speed": { "type": "number", "min": 0, "default": 0.5, "recommended": [0.1, 2.0] },
                "color": { "type": "rgb", "default": [255, 255, 255] },
                "background": { "type": "rgb", "default": [0, 0, 0] }
              }
            },
            "fire": {
              "params": {
                "intensity": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] }
              }
            },
            "window_light": {
              "params": {
                "color": { "type": "rgb", "default": [255, 180, 50] },
                "flicker_speed": { "type": "number", "min": 0, "default": 0.3, "recommended": [0.1, 1.0] }
              }
            },
            "candle": {
              "params": {
                "intensity": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 1.5] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] }
              }
            },
            "sunrise": { "params": {}, "transition": true, "notes": "duration per defecte 10.0 s." },
            "sunset": { "params": {}, "transition": true, "notes": "duration per defecte 15.0 s." },
            "moonlight": {
              "params": {
                "brightness": { "type": "number", "min": 0, "max": 1, "default": 0.3, "recommended": [0.1, 0.5] },
                "flicker": { "type": "number", "min": 0, "default": 0.05, "recommended": [0.0, 0.1] }
              }
            },
            "clouds": {
              "params": {
                "speed": { "type": "number", "min": 0, "default": 0.5, "recommended": [0.1, 2.0] },
                "color": { "type": "rgb", "default": [200, 200, 220] }
              }
            },
            "shooting_star": {
              "params": {
                "color": { "type": "rgb", "default": [255, 255, 255] },
                "speed": { "type": "number", "min": 0, "default": 2.0, "recommended": [1.0, 5.0] },
                "interval": { "type": "number", "min": 0, "default": 30.0, "recommended": [10.0, 60.0] }
              }
            },
            "aurora": {
              "params": {
                "speed": { "type": "number", "min": 0, "default": 0.3, "recommended": [0.1, 1.0] },
                "intensity": { "type": "number", "min": 0, "default": 0.6, "recommended": [0.3, 1.0] }
              }
            },
            "snow": {
              "params": {
                "density": { "type": "number", "min": 0, "max": 1, "default": 0.05, "recommended": [0.01, 0.2] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 3.0] },
                "background": { "type": "rgb", "default": [10, 20, 50] }
              }
            }
          }
        },
        "setBrightness": {
          "params": { "brightness": { "type": "int", "required": true, "min": 0, "max": 255 } }
        }
      }
    },
    "led_segment": {
      "controller": "LedsController",
      "infrastructure": false,
      "pin": false,
      "legacy": { "addressing": "name" },
      "config": {
        "strip": { "type": "string", "required": true, "ref": "led_strip" },
        "first": { "type": "int", "required": true, "min": 0 },
        "last": { "type": "int", "required": true, "min": 0 }
      },
      "actions": {
        "fill": {
          "params": {
            "color": { "type": "rgb", "required": true },
            "first": { "type": "int", "min": 0 },
            "last": { "type": "int", "min": 0 }
          }
        },
        "clear": { "params": {} },
        "animate": {
          "continuous": true,
          "params": {
            "animation_type": {
              "type": "enum",
              "required": true,
              "values": ["stars", "fire", "window_light", "candle", "moonlight", "clouds", "shooting_star", "aurora", "snow", "fade", "sunrise", "sunset"]
            },
            "first": { "type": "int", "min": 0 },
            "last": { "type": "int", "min": 0 },
            "duration": { "type": "number", "min": 0, "duration": true }
          },
          "animations": {
            "fade": {
              "params": {
                "color": { "type": "rgb", "required": true },
                "from_color": { "type": "rgb" },
                "waypoints": { "type": "rgb_list", "notes": "Colors intermedis entre from_color i color; la durada es reparteix a parts iguals entre trams." }
              },
              "transition": true,
              "notes": "duration per defecte 1.0 s. Sense from_color comença des del color del fade anterior o des de negre."
            },
            "stars": {
              "params": {
                "density": { "type": "number", "min": 0, "max": 1, "default": 0.1 },
                "speed": { "type": "number", "min": 0, "default": 0.5, "recommended": [0.1, 2.0] },
                "color": { "type": "rgb", "default": [255, 255, 255] },
                "background": { "type": "rgb", "default": [0, 0, 0] }
              }
            },
            "fire": {
              "params": {
                "intensity": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] }
              }
            },
            "window_light": {
              "params": {
                "color": { "type": "rgb", "default": [255, 180, 50] },
                "flicker_speed": { "type": "number", "min": 0, "default": 0.3, "recommended": [0.1, 1.0] }
              }
            },
            "candle": {
              "params": {
                "intensity": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 1.5] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 2.0] }
              }
            },
            "sunrise": { "params": {}, "transition": true, "notes": "duration per defecte 10.0 s." },
            "sunset": { "params": {}, "transition": true, "notes": "duration per defecte 15.0 s." },
            "moonlight": {
              "params": {
                "brightness": { "type": "number", "min": 0, "max": 1, "default": 0.3, "recommended": [0.1, 0.5] },
                "flicker": { "type": "number", "min": 0, "default": 0.05, "recommended": [0.0, 0.1] }
              }
            },
            "clouds": {
              "params": {
                "speed": { "type": "number", "min": 0, "default": 0.5, "recommended": [0.1, 2.0] },
                "color": { "type": "rgb", "default": [200, 200, 220] }
              }
            },
            "shooting_star": {
              "params": {
                "color": { "type": "rgb", "default": [255, 255, 255] },
                "speed": { "type": "number", "min": 0, "default": 2.0, "recommended": [1.0, 5.0] },
                "interval": { "type": "number", "min": 0, "default": 30.0, "recommended": [10.0, 60.0] }
              }
            },
            "aurora": {
              "params": {
                "speed": { "type": "number", "min": 0, "default": 0.3, "recommended": [0.1, 1.0] },
                "intensity": { "type": "number", "min": 0, "default": 0.6, "recommended": [0.3, 1.0] }
              }
            },
            "snow": {
              "params": {
                "density": { "type": "number", "min": 0, "max": 1, "default": 0.05, "recommended": [0.01, 0.2] },
                "speed": { "type": "number", "min": 0, "default": 1.0, "recommended": [0.5, 3.0] },
                "background": { "type": "rgb", "default": [10, 20, 50] }
              }
            }
          }
        }
      }
    },
    "motor": {
      "controller": "MotorController",
      "infrastructure": false,
      "pin": false,
      "notes": "Motor bidireccional amb pont H (IN1/IN2): dues sortides, sentit normal i invertit, que mai s'activen alhora. O bé dos GPIO (pinForward + pinReverse) o bé dos canals del mateix expansor (expander + channelForward + channelReverse). El temps de gir és la durada del clip; maxTime de cada sentit és el tall dur i limit<Sentit> el final de carrera (un port sensor).",
      "legacy": { "addressing": "name" },
      "config": {
        "pinForward": { "type": "int", "min": 0, "max": 27, "notes": "GPIO de la sortida de sentit normal (IN1)." },
        "pinReverse": { "type": "int", "min": 0, "max": 27, "notes": "GPIO de la sortida de sentit invertit (IN2)." },
        "expander": { "type": "string", "ref": "gpio_expander", "notes": "Expansor de les dues sortides; amb expander calen channelForward i channelReverse i no hi pot haver pins." },
        "channelForward": { "type": "int", "min": 0, "max": 15 },
        "channelReverse": { "type": "int", "min": 0, "max": 15 },
        "activeLow": { "type": "bool", "default": false, "notes": "Només sortides natives; en un expansor mana la placa." },
        "switchDelayMs": { "type": "int", "min": 0, "max": 5000, "default": 50, "notes": "Temps amb les dues sortides apagades en invertir el sentit." },
        "maxTimeForward": { "type": "number", "required": true, "min": 0, "notes": "Segons màxims seguits girant en sentit normal (tall dur)." },
        "maxTimeReverse": { "type": "number", "required": true, "min": 0, "notes": "Segons màxims seguits girant en sentit invertit (tall dur)." },
        "limitForward": { "type": "string", "ref": "sensor", "notes": "Final de carrera del sentit normal: en activar-se, el motor para." },
        "limitReverse": { "type": "string", "ref": "sensor", "notes": "Final de carrera del sentit invertit." },
        "lockOnTimeout": { "type": "bool", "default": false, "notes": "Si un sentit amb final de carrera acaba per maxTime, el motor queda bloquejat fins que algú el desbloquegi." }
      },
      "actions": {
        "forward": {
          "params": { "time": { "type": "number", "min": 0, "duration": true, "notes": "Segons de gir (la durada del clip); sense valor, fins al final de carrera o maxTimeForward." } }
        },
        "reverse": {
          "params": { "time": { "type": "number", "min": 0, "duration": true, "notes": "Segons de gir (la durada del clip); sense valor, fins al final de carrera o maxTimeReverse." } }
        },
        "stop": { "params": {} }
      }
    },
    "audio": {
      "controller": "AudioController",
      "infrastructure": false,
      "pin": false,
      "legacy": { "addressing": "controller" },
      "config": {},
      "actions": {
        "play": {
          "params": {
            "audio_name": { "type": "string", "required": true, "asset": "audio", "notes": "Nom d'asset «<attachmentId>-<fitxer>» d'un adjunt AUDIO de la peça (vegeu README)." },
            "start": { "type": "number", "min": 0, "default": 0, "notes": "Segon del fitxer on comença la reproducció (retalla el principi)." },
            "time": { "type": "number", "min": 0, "duration": true, "notes": "Segons que sona a partir de start; sense valor, fins al final del fitxer." }
          }
        },
        "stop": { "params": {}, "unsupported": ["player_id"] }
      }
    },
    "moving_head": {
      "controller": "DmxController",
      "infrastructure": false,
      "pin": false,
      "notes": "Cap mòbil (wash) per DMX512 a través d'un adaptador USB→DMX. address és el primer canal del aparell (menú DMX Address); profile diu quants canals ocupa i com es converteixen les unitats físiques (graus, percentatge, RGBW) a canals (vegeu profiles.moving_head). Diversos caps comparteixen el mateix univers; els seus rangs de canals no es poden solapar.",
      "legacy": { "addressing": "name" },
      "config": {
        "profile": { "type": "enum", "required": true, "values": ["varytec-hero-wash-712z"] },
        "address": { "type": "int", "required": true, "min": 1, "max": 512, "notes": "Primer canal DMX (1–512); address + canals − 1 ≤ 512." }
      },
      "actions": {
        "set": {
          "transition": true,
          "notes": "Un cue: porta els paràmetres indicats des del valor actual al nou en time segons (sense time, immediat). Els no indicats no canvien.",
          "params": {
            "color": { "type": "rgb" },
            "white": { "type": "int", "min": 0, "max": 255 },
            "intensity": { "type": "number", "min": 0, "max": 100, "notes": "Percentatge del dimmer." },
            "pan": { "type": "number", "min": 0, "max": 540, "notes": "Graus (0 … pan màxim del perfil)." },
            "tilt": { "type": "number", "min": 0, "max": 190, "notes": "Graus (0 … tilt màxim del perfil)." },
            "zoom": { "type": "number", "min": 6, "max": 36, "notes": "Angle del feix en graus (rang del perfil)." },
            "time": { "type": "number", "min": 0, "duration": true }
          }
        },
        "blackout": {
          "transition": true,
          "notes": "intensity → 0 en time segons; el cap no es mou.",
          "params": { "time": { "type": "number", "min": 0, "duration": true } }
        }
      }
    },
    "sensor": {
      "controller": "InputController",
      "infrastructure": true,
      "pin": "optional",
      "notes": "Entrada amb nom que està activa o no. source digital (per defecte): entrada digital (IR amb potenciòmetre, final de carrera, seta, polsador), o bé un GPIO (pin) o bé un canal d'un expansor (expander + channel), activa a nivell baix amb pull-up per defecte. source measured: un sensor que mesura un valor (distància, temperatura…) segons el seu model (vegeu profiles.sensor) i que està actiu quan el valor passa del llindar (threshold, activeWhen above/below, amb histèresi). onActive diu què fa el reproductor amb el show quan s'activa: play arrenca un passi (el polsador, amb la pulsació llarga de rescat: 10 s Wi-Fi pròpia, 30 s tot en segur), stop_show para el passi i panic ho posa tot en segur.",
      "legacy": { "addressing": "name", "pinType": "Pulsador", "module": "input" },
      "config": {
        "expander": { "type": "string", "ref": "gpio_expander", "notes": "Expansor del qual és el canal d'entrada; amb expander cal channel i no hi pot haver pin." },
        "channel": { "type": "int", "min": 0, "max": 15 },
        "activeLow": { "type": "bool", "default": true, "notes": "Actiu quan l'entrada és a nivell baix (contacte a massa)." },
        "pull": { "type": "enum", "values": ["up", "down", "none"], "default": "up", "notes": "Resistència interna; en un expansor, només up o none." },
        "debounceMs": { "type": "int", "min": 0, "max": 2000, "default": 50 },
        "onActive": { "type": "enum", "values": ["none", "play", "stop_show", "panic"], "default": "none" },
        "source": { "type": "enum", "values": ["digital", "measured"], "default": "digital", "notes": "digital: entrada activa o no. measured: un model de profiles.sensor que llegeix un valor i s'activa en passar el llindar." },
        "model": { "type": "enum", "values": ["vl53l0x", "hc-sr04", "ds18b20", "bme280"], "notes": "Perfil del sensor mesurat (profiles.sensor); obligatori amb source measured." },
        "quantity": { "type": "enum", "values": ["distance", "temperature", "humidity", "pressure"], "notes": "Magnitud que es vigila; obligatòria si el model en mesura més d'una (per defecte, l'única del model)." },
        "bus": { "type": "int", "min": 0, "max": 1, "default": 1, "notes": "Bus I2C (models amb wiring i2c)." },
        "address": { "type": "int", "min": 8, "max": 119, "notes": "Adreça I2C (una de profiles.sensor.<model>.addresses; per defecte, la primera), única per bus amb els expansors." },
        "pinTrig": { "type": "int", "min": 0, "max": 27, "notes": "GPIO del TRIG (models amb wiring trig_echo)." },
        "pinEcho": { "type": "int", "min": 0, "max": 27, "notes": "GPIO de l'ECHO (models amb wiring trig_echo); a 3,3 V." },
        "deviceId": { "type": "string", "notes": "Identificador 1-Wire (28-xxxxxxxxxxxx); sense, el primer sensor del bus." },
        "threshold": { "type": "number", "notes": "Llindar en la unitat de la magnitud (profiles.sensor.<model>.quantities); obligatori amb source measured." },
        "activeWhen": { "type": "enum", "values": ["above", "below"], "notes": "above: actiu quan el valor arriba al llindar o el supera; below: quan hi arriba o queda per sota. Obligatori amb source measured." },
        "hysteresis": { "type": "number", "min": 0, "default": 0, "notes": "Marge per desactivar-se: amb below, inactiu quan el valor supera threshold + hysteresis; amb above, quan baixa de threshold − hysteresis." },
        "pollMs": { "type": "int", "min": 50, "max": 60000, "notes": "Cada quant es llegeix el valor; per defecte, el pollMs del model." }
      },
      "actions": {}
    }
  },
  "profiles": {
    "moving_head": {
      "varytec-hero-wash-712z": {
        "name": "Varytec Hero Wash 712 Z RGBW Zoom",
        "mode": "DMX 15 Ch",
        "channels": 15,
        "pan": { "max": 540 },
        "tilt": { "max": 190 },
        "zoom": { "min": 6, "max": 36 },
        "map": { "pan": 1, "panFine": 2, "tilt": 3, "tiltFine": 4, "speed": 5, "dimmer": 6, "shutter": 7, "red": 8, "green": 9, "blue": 10, "white": 11, "colorTemp": 12, "macros": 13, "zoom": 14, "programs": 15 },
        "fixed": { "speed": 0, "shutter": 0, "colorTemp": 0, "macros": 0, "programs": 0 },
        "notes": "Manual Varytec §7.4. Al menú de l'aparell: DMX Channel = DMX 15 Ch, Running Mode = DMX, Settings → Dmx Fail = OFF (sense senyal s'apaga)."
      }
    },
    "sensor": {
      "vl53l0x": {
        "name": "VL53L0X (distància làser ToF, I2C)",
        "wiring": "i2c",
        "addresses": [41],
        "quantities": { "distance": { "unit": "cm", "min": 3, "max": 200 } },
        "pollMs": 100,
        "notes": "VIN a 3,3 V, SDA al GPIO 2 i SCL al GPIO 3 (els comparteix amb els expansors). Adreça fixa 0x29: un per bus."
      },
      "hc-sr04": {
        "name": "HC-SR04 (distància per ultrasons)",
        "wiring": "trig_echo",
        "quantities": { "distance": { "unit": "cm", "min": 2, "max": 400 } },
        "pollMs": 100,
        "notes": "S'alimenta a 5 V i l'ECHO surt a 5 V: cal un divisor de tensió (1 kΩ i 2 kΩ) abans del GPIO."
      },
      "ds18b20": {
        "name": "DS18B20 (temperatura, 1-Wire)",
        "wiring": "onewire",
