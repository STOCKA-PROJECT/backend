}

auth:bearer {
  token: {{JWTtoken}}
}

body:json {
  {
    "name": "Sembra bis",
    "kind": "relay",
    "pieceTypeId": {{pieceTypeId}},
    "pin": 26
  }
}

docs {
  409 ports.pin_conflict: el pin 26 ya lo usa "Sembra" (create-port). Los pines de un motor en config también cuentan.
}
