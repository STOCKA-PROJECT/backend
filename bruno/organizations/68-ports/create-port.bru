meta {
  name: Create Port (relay)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/organizations/{{orgId}}/ports
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{JWTtoken}}
}

body:json {
  {
    "name": "Sembra",
    "kind": "relay",
    "pieceTypeId": {{pieceTypeId}},
    "pin": 26
  }
}

docs {
  `kind` obligatorio e inmutable. Un relé lleva `pin` (GPIO BCM 2–27, 0 y 1 reservados) y
  necesita un tipo de artículo con kind=relay. Captura `portId`.
}
